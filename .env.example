# --- Postgres ---
POSTGRES_USER=autoinsta
POSTGRES_PASSWORD=autoinsta
POSTGRES_DB=autoinsta
DATABASE_URL=postgresql+psycopg://autoinsta:autoinsta@localhost:5432/autoinsta

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=autoinsta
RABBITMQ_DEFAULT_PASS=autoinsta
RABBITMQ_URL=amqp://autoinsta:autoinsta@localhost:5672/

# --- JWT ---
# py -3.12 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Credential vault ---
# py -3.12 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Instagram / Meta ---
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/instagram/callback

# --- AI ---
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO